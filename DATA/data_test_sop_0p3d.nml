&TOTAL_HAMILTONIAN
N_mat = 0
N_cav = 3
/

!--- NEEED ONLY ONE NML FOR ALL OPERATORS (related to the same modes) !!!
&Cavity_mode
lambda = 1.0                              !Strength parameter of the coupling between the mode D and the molecule
Nb = 2                                    !Number of basis vectors associated with the HO D
w = 0.0068665                             !Eigenpulsation associated with the HO D (maybe HF molecule : 0.005866505831680149)
m = 1.0                                   !Mass associated with the HO D
Nq = 1
Eq_pos = 0.0                              !Equilibrium position of the HO
Scale_q = 0.0
/

